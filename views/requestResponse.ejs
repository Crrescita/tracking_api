<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      line-height: 1.6;
      background-color: #f0f2f5;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .card {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #2e7d32, #4caf50);
      padding: 24px 20px;
      text-align: center;
    }

    .header img {
      max-width: 160px;
      height: auto;
      margin-bottom: 16px;
    }

    .header h2 {
      color: #ffffff;
      font-size: 22px;
      margin: 0;
      font-weight: 600;
    }

    .header .badge {
      display: inline-block;
      background-color: rgba(255, 255, 255, 0.2);
      color: #fff;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      margin-top: 8px;
    }

    .body-content {
      padding: 24px 24px 16px;
    }

    .greeting {
      font-size: 16px;
      color: #333;
      margin-bottom: 16px;
    }

    .status-banner {
      text-align: center;
      padding: 14px;
      background-color: #e8f5e9;
      border: 1px solid #a5d6a7;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .status-banner .status-icon {
      font-size: 28px;
      display: block;
      margin-bottom: 4px;
    }

    .status-banner .status-text {
      font-size: 16px;
      font-weight: 600;
      color: #2e7d32;
    }

    .status-banner .status-sub {
      font-size: 13px;
      color: #555;
      margin-top: 4px;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
    }

    .detail-table tr {
      border-bottom: 1px solid #f0f0f0;
    }

    .detail-table tr:last-child {
      border-bottom: none;
    }

    .detail-table td {
      padding: 12px 16px;
      font-size: 14px;
      color: #555;
      vertical-align: top;
    }

    .detail-table td:first-child {
      font-weight: 600;
      color: #333;
      width: 35%;
      white-space: nowrap;
    }

    .admin-note {
      background-color: #f3e5f5;
      border-left: 4px solid #9c27b0;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin: 16px 0;
      font-size: 14px;
      color: #555;
    }

    .admin-note strong {
      color: #6a1b9a;
    }

    .attachments {
      margin: 16px 0;
      padding: 14px 16px;
      background-color: #f8f9fa;
      border-radius: 8px;
    }

    .attachments-title {
      font-size: 14px;
      font-weight: 600;
      color: #333;
      margin-bottom: 8px;
    }

    .attachment-link {
      display: inline-block;
      background-color: #e3f2fd;
      color: #1565c0;
      padding: 6px 12px;
      border-radius: 6px;
      text-decoration: none;
      font-size: 13px;
      margin: 4px 4px 4px 0;
    }

    .info-note {
      text-align: center;
      padding: 14px;
      background-color: #e8f5e9;
      border: 1px solid #a5d6a7;
      border-radius: 8px;
      margin: 16px 0;
      font-size: 14px;
      color: #33691e;
    }

    .footer {
      background-color: #0a051e;
      text-align: center;
      padding: 16px 20px;
      color: #999;
      font-size: 12px;
    }

    .footer p {
      margin: 3px 0;
      color: #bbb;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <img src="https://trackingapi.crrescita.com/images/company/logo2024-10-11T12-03-49.507Z-abpallogo.jpeg"
          alt="A B Pal" />
        <h2>Your Request is Ready</h2>
        <span class="badge">Request #<%= request_id %></span>
      </div>

      <div class="body-content">
        <p class="greeting">Hello <strong><%= employee_name %></strong>,</p>

        <div class="status-banner">
          <span class="status-icon">✅</span>
          <span class="status-text">Request Processed Successfully</span>
          <p class="status-sub">Your <strong><%= type %></strong> request has been reviewed and is now ready.</p>
        </div>

        <table class="detail-table">
          <tr>
            <td>📋 Request ID</td>
            <td>#<%= request_id %></td>
          </tr>
          <tr>
            <td>📁 Type</td>
            <td><%= type %></td>
          </tr>
          <tr>
            <td>📊 Status</td>
            <td><strong style="color:#2e7d32;">Ready</strong></td>
          </tr>
        </table>

        <% if (admin_note) { %>
          <div class="admin-note">
            <strong>💬 Admin Note:</strong><br />
            <%= admin_note %>
          </div>
        <% } %>

        <% if (attachments && attachments.length > 0) { %>
          <div class="attachments">
            <p class="attachments-title">📎 Files Attached (<%= attachments.length %>)</p>
            <% attachments.forEach(function(file) { %>
              <a href="<%= file %>" target="_blank" class="attachment-link">
                📄 <%= file.split('/').pop() %>
              </a>
            <% }) %>
          </div>
        <% } %>

        <div class="info-note">
          📱 Open the <strong>T.E.L App</strong> to view the complete details and download any attached documents.
        </div>
      </div>

      <div class="footer">
        <p>&copy; 2026 Crrescita. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</body>

</html>