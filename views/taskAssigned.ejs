<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      line-height: 1.6;
      background-color: #f0f2f5;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .card {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #1565c0, #42a5f5);
      padding: 24px 20px;
      text-align: center;
    }

    .header img {
      max-width: 160px;
      height: auto;
      margin-bottom: 16px;
    }

    .header h2 {
      color: #ffffff;
      font-size: 22px;
      margin: 0;
      font-weight: 600;
    }

    .header .badge {
      display: inline-block;
      background-color: rgba(255, 255, 255, 0.2);
      color: #fff;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      margin-top: 8px;
    }

    .body-content {
      padding: 24px 24px 16px;
    }

    .greeting {
      font-size: 16px;
      color: #333;
      margin-bottom: 16px;
    }

    .info-message {
      background-color: #e3f2fd;
      border-left: 4px solid #1565c0;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin-bottom: 20px;
      font-size: 14px;
      color: #1a237e;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
    }

    .detail-table tr {
      border-bottom: 1px solid #f0f0f0;
    }

    .detail-table tr:last-child {
      border-bottom: none;
    }

    .detail-table td {
      padding: 12px 16px;
      font-size: 14px;
      color: #555;
      vertical-align: top;
    }

    .detail-table td:first-child {
      font-weight: 600;
      color: #333;
      width: 35%;
      white-space: nowrap;
    }

    .date-row {
      display: flex;
      gap: 16px;
      margin: 16px 0;
    }

    .date-box {
      flex: 1;
      background-color: #f8f9fa;
      border-radius: 8px;
      padding: 14px 16px;
      text-align: center;
    }

    .date-box .label {
      font-size: 12px;
      color: #888;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 4px;
    }

    .date-box .value {
      font-size: 15px;
      font-weight: 600;
      color: #333;
    }

    .action-note {
      text-align: center;
      padding: 16px;
      background-color: #e3f2fd;
      border: 1px solid #90caf9;
      border-radius: 8px;
      margin: 16px 0;
      font-size: 14px;
      color: #0d47a1;
    }

    .footer {
      background-color: #0a051e;
      text-align: center;
      padding: 16px 20px;
      font-size: 12px;
    }

    .footer p {
      margin: 3px 0;
      color: #bbb;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <img src="https://trackingapi.crrescita.com/images/company/logo2024-10-11T12-03-49.507Z-abpallogo.jpeg"
          alt="A B Pal" />
        <h2>📋 New Task Assigned</h2>
        <span class="badge">Task ID: <%= task_id %></span>
      </div>

      <div class="body-content">
        <p class="greeting">Hello <strong><%= employee_name %></strong>,</p>

        <div class="info-message">
          You have been assigned a new task. Please review the details below and complete it within the given timeline.
        </div>

        <table class="detail-table">
          <tr>
            <td>🆔 Task ID</td>
            <td><%= task_id %></td>
          </tr>
          <tr>
            <td>📝 Task Title</td>
            <td><strong><%= task_title %></strong></td>
          </tr>
        </table>

        <!-- Date boxes -->
        <table width="100%" cellpadding="0" cellspacing="0" style="margin: 16px 0;">
          <tr>
            <td width="48%" style="padding-right: 8px;">
              <div style="background-color: #e8f5e9; border-radius: 8px; padding: 14px 16px; text-align: center;">
                <div style="font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">📅 Start Date</div>
                <div style="font-size: 15px; font-weight: 600; color: #2e7d32;"><%= start_date %></div>
              </div>
            </td>
            <td width="4%"></td>
            <td width="48%" style="padding-left: 8px;">
              <div style="background-color: #fce4ec; border-radius: 8px; padding: 14px 16px; text-align: center;">
                <div style="font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;">⏰ End Date</div>
                <div style="font-size: 15px; font-weight: 600; color: #c62828;"><%= end_date %></div>
              </div>
            </td>
          </tr>
        </table>

        <div class="action-note">
          📱 Open the <strong>T.E.L App</strong> to view full details and update your task progress.
        </div>
      </div>

      <div class="footer">
        <p>&copy; 2026 Crrescita. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</body>

</html>