<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      background-color: #f5f5f5;
      margin: 0;
      padding: 0;
    }

    .logo {
      margin-top: 10px;
      margin-bottom: 20px;
    }

    .container {
      max-width: 700px;
      margin: 0 auto;
      padding: 20px;
    }

    .card {
      background-color: #ffffff;
      border: 1px solid #655252;
      padding: 20px;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .card-title {
      font-size: 24px;
      font-weight: bold;
      color: #d9534f;
      text-align: center;
      margin-top: 5px;
      margin-bottom: 20px;
    }

    .normal-text {
      font-size: 16px;
      color: #655252;
      margin-top: 5px;
    }

    .card-text {
      font-size: 16px;
      color: #666666;
      text-align: center;
      margin-bottom: 15px;
      margin-top: 15px;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 20px 0;
    }

    .detail-table td {
      padding: 10px 15px;
      border-bottom: 1px solid #eee;
      font-size: 15px;
      color: #555;
    }

    .detail-table td:first-child {
      font-weight: bold;
      color: #655252;
      width: 40%;
    }

    .highlight {
      background-color: #fff3cd;
      border: 1px solid #ffc107;
      border-radius: 8px;
      padding: 15px;
      text-align: center;
      margin: 20px 0;
    }

    .highlight p {
      margin: 5px 0;
      font-size: 15px;
      color: #856404;
    }

    .footer {
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px solid #0a051e;
      text-align: center;
      background-color: #0a051e;
      border-radius: 0 0 10px 10px;
      color: white;
      margin-bottom: 15px;
      padding: 15px;
    }

    .footer p {
      margin: 5px 0;
    }

    img {
      max-width: 200px;
      height: auto;
      display: block;
      margin: 0 auto;
    }

    .center {
      text-align: center;
      justify-content: center;
    }
  </style>
</head>

<body>

  <div class="container">
    <div class="card">
      <div class="center logo">
        <img src="https://trackingapi.crrescita.com/images/company/logo2024-10-11T12-03-49.507Z-abpallogo.jpeg"
          alt="A B Pal" style="max-width: 200px" />
      </div>
      <h2 class="card-title">⏰ Follow-Up Reminder</h2>
      <p class="card-text">
        Hi <strong>
          <%= employee_name %>
        </strong>, your follow-up date has expired for the following request.
      </p>

      <table class="detail-table">
        <tr>
          <td>Request ID</td>
          <td>#<%= request_id %>
          </td>
        </tr>
        <tr>
          <td>Request Type</td>
          <td>
            <%= type %>
          </td>
        </tr>
        <tr>
          <td>Title</td>
          <td>
            <%= title %>
          </td>
        </tr>
        <tr>
          <td>Follow-Up Date</td>
          <td>
            <%= followup_date %>
          </td>
        </tr>
        <tr>
          <td>Previous Follow-Up</td>
          <td>
            <%= previous_followup %>
          </td>
        </tr>
      </table>

      <div class="highlight">
        <p><strong>Action Required</strong></p>
        <p>Please update the follow-up date in the <strong>T.E.L App</strong> at your earliest convenience.</p>
      </div>

      <div class="footer">
        <p>&copy; 2026 Crrescita.</p>
        <p>All Rights Reserved.</p>
      </div>
    </div>
  </div>
</body>

</html>