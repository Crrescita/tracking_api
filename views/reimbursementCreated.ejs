<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      line-height: 1.6;
      background-color: #f0f2f5;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .card {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #303f9f, #3f51b5);
      padding: 24px 20px;
      text-align: center;
    }

    .header img {
      max-width: 160px;
      height: auto;
      margin-bottom: 16px;
    }

    .header h2 {
      color: #ffffff;
      font-size: 22px;
      margin: 0;
      font-weight: 600;
    }

    .header .badge {
      display: inline-block;
      background-color: rgba(255, 255, 255, 0.2);
      color: #fff;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      margin-top: 8px;
    }

    .body-content {
      padding: 24px 24px 16px;
    }

    .greeting {
      font-size: 16px;
      color: #333;
      margin-bottom: 16px;
    }

    .info-message {
      background-color: #e8eaf6;
      border-left: 4px solid #3f51b5;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin-bottom: 20px;
      font-size: 14px;
      color: #1a237e;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
    }

    .detail-table tr {
      border-bottom: 1px solid #f0f0f0;
    }

    .detail-table tr:last-child {
      border-bottom: none;
    }

    .detail-table td {
      padding: 12px 16px;
      font-size: 14px;
      color: #555;
      vertical-align: top;
    }

    .detail-table td:first-child {
      font-weight: 600;
      color: #333;
      width: 35%;
      white-space: nowrap;
    }

    .action-banner {
      background-color: #ffe082;
      border: 1px solid #ffca28;
      border-radius: 8px;
      padding: 14px;
      text-align: center;
      margin-top: 20px;
      font-size: 14px;
      color: #7f6d00;
    }

    .footer {
      background-color: #0a051e;
      text-align: center;
      padding: 16px 20px;
      font-size: 12px;
    }

    .footer p {
      margin: 3px 0;
      color: #bbb;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <img src="https://trackingapi.crrescita.com/images/company/logo2024-10-11T12-03-49.507Z-abpallogo.jpeg"
          alt="T.E.L" />
        <h2>New Reimbursement Request</h2>
        <span class="badge">Reference #<%= reimbursement_id %></span>
      </div>

      <div class="body-content">
        <p class="greeting">Hello Admin,</p>

        <div class="info-message">
          <strong><%= employee_name %></strong> has submitted a new reimbursement request. Please review the details below.
        </div>

        <table class="detail-table">
          <tr>
            <td>👤 Employee Name</td>
            <td><strong><%= employee_name %></strong></td>
          </tr>
          <tr>
            <td>📁 Type</td>
            <td><%= type %></td>
          </tr>
          <tr>
            <td>💵 Total Amount</td>
            <td style="color:#2e7d32; font-weight:600;">₹ <%= amount %></td>
          </tr>
          <tr>
            <td>📅 Applied Date</td>
            <td><%= applied_date %></td>
          </tr>
        </table>

        <div class="action-banner">
          ⚠️ <strong>Action Required:</strong> Please log in to the admin panel to review and process this request.
        </div>
      </div>

      <div class="footer">
        <p>&copy; 2026 Crrescita. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</body>

</html>