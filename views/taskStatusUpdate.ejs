<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      line-height: 1.6;
      background-color: #f0f2f5;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .card {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .header {
      background: linear-gradient(135deg, #ff8f00, #ffca28);
      padding: 24px 20px;
      text-align: center;
    }

    .header img {
      max-width: 160px;
      height: auto;
      margin-bottom: 16px;
    }

    .header h2 {
      color: #ffffff;
      font-size: 22px;
      margin: 0;
      font-weight: 600;
      text-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }

    .header .badge {
      display: inline-block;
      background-color: rgba(255, 255, 255, 0.25);
      color: #fff;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      margin-top: 8px;
      text-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }

    .body-content {
      padding: 24px 24px 16px;
    }

    .greeting {
      font-size: 16px;
      color: #333;
      margin-bottom: 16px;
    }

    .status-banner {
      text-align: center;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .status-banner .status-icon {
      font-size: 28px;
      display: block;
      margin-bottom: 4px;
    }

    .status-banner .status-text {
      font-size: 16px;
      font-weight: 600;
    }

    .status-completed {
      background-color: #e8f5e9;
      border: 1px solid #a5d6a7;
    }

    .status-completed .status-text {
      color: #2e7d32;
    }

    .status-in-progress {
      background-color: #fff3e0;
      border: 1px solid #ffcc80;
    }

    .status-in-progress .status-text {
      color: #e65100;
    }

    .status-cancelled {
      background-color: #fce4ec;
      border: 1px solid #ef9a9a;
    }

    .status-cancelled .status-text {
      color: #c62828;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
    }

    .detail-table tr {
      border-bottom: 1px solid #f0f0f0;
    }

    .detail-table tr:last-child {
      border-bottom: none;
    }

    .detail-table td {
      padding: 12px 16px;
      font-size: 14px;
      color: #555;
      vertical-align: top;
    }

    .detail-table td:first-child {
      font-weight: 600;
      color: #333;
      width: 35%;
      white-space: nowrap;
    }

    .comment-box {
      background-color: #f3e5f5;
      border-left: 4px solid #9c27b0;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin: 16px 0;
      font-size: 14px;
      color: #4a148c;
    }

    .comment-box strong {
      color: #6a1b9a;
    }

    .info-note {
      text-align: center;
      padding: 14px;
      background-color: #f5f5f5;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      margin: 16px 0;
      font-size: 14px;
      color: #555;
    }

    .footer {
      background-color: #0a051e;
      text-align: center;
      padding: 16px 20px;
      font-size: 12px;
    }

    .footer p {
      margin: 3px 0;
      color: #bbb;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="card">
      <div class="header">
        <img src="https://trackingapi.crrescita.com/images/company/logo2024-10-11T12-03-49.507Z-abpallogo.jpeg"
          alt="A B Pal" />
        <h2>🔔 Task Status Updated</h2>
        <span class="badge">Task #<%= task_id %></span>
      </div>

      <div class="body-content">
        <p class="greeting">Hello Admin,</p>

        <!-- Status Banner — changes color based on status -->
        <% if (status.toLowerCase() === 'completed') { %>
          <div class="status-banner status-completed">
            <span class="status-icon">✅</span>
            <span class="status-text">Task Completed</span>
          </div>
        <% } else if (status.toLowerCase() === 'in-progress') { %>
          <div class="status-banner status-in-progress">
            <span class="status-icon">🔄</span>
            <span class="status-text">Task In Progress</span>
          </div>
        <% } else if (status.toLowerCase() === 'cancelled') { %>
          <div class="status-banner status-cancelled">
            <span class="status-icon">❌</span>
            <span class="status-text">Task Cancelled</span>
          </div>
        <% } else { %>
          <div class="status-banner" style="background-color:#f5f5f5; border:1px solid #e0e0e0;">
            <span class="status-icon">📋</span>
            <span class="status-text" style="color:#333;"><%= status %></span>
          </div>
        <% } %>

        <table class="detail-table">
          <tr>
            <td>👤 Employee</td>
            <td><strong><%= employee_name %></strong></td>
          </tr>
          <tr>
            <td>📝 Task</td>
            <td><%= task_title %></td>
          </tr>
          <tr>
            <td>📊 Status</td>
            <td><strong><%= status %></strong></td>
          </tr>
        </table>

        <% if (comment) { %>
          <div class="comment-box">
            <strong>💬 Employee Comment:</strong><br />
            <%= comment %>
          </div>
        <% } %>

        <div class="info-note">
          📱 Log in to the <strong>Admin Dashboard</strong> to review this task and take any necessary action.
        </div>
      </div>

      <div class="footer">
        <p>&copy; 2026 Crrescita. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</body>

</html>