<!DOCTYPE html>
<html>

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    body {
      font-family: 'Segoe UI', Arial, sans-serif;
      line-height: 1.6;
      background-color: #f0f2f5;
      margin: 0;
      padding: 0;
    }

    .container {
      max-width: 640px;
      margin: 0 auto;
      padding: 24px 16px;
    }

    .card {
      background-color: #ffffff;
      border-radius: 12px;
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
      overflow: hidden;
    }

    .header {
      padding: 24px 20px;
      text-align: center;
    }

    .header img {
      max-width: 160px;
      height: auto;
      margin-bottom: 16px;
    }

    .header h2 {
      color: #ffffff;
      font-size: 22px;
      margin: 0;
      font-weight: 600;
    }

    .header .badge {
      display: inline-block;
      background-color: rgba(255, 255, 255, 0.2);
      color: #fff;
      padding: 4px 14px;
      border-radius: 20px;
      font-size: 13px;
      margin-top: 8px;
    }

    .header-approved {
      background: linear-gradient(135deg, #2e7d32, #4caf50);
    }

    .header-reject {
      background: linear-gradient(135deg, #c62828, #ef5350);
    }

    .header-default {
      background: linear-gradient(135deg, #6a1b9a, #ab47bc);
    }

    .body-content {
      padding: 24px 24px 16px;
    }

    .greeting {
      font-size: 16px;
      color: #333;
      margin-bottom: 16px;
    }

    .status-banner {
      text-align: center;
      padding: 16px;
      border-radius: 8px;
      margin-bottom: 20px;
    }

    .status-banner .status-icon {
      font-size: 28px;
      display: block;
      margin-bottom: 4px;
    }

    .status-banner .status-text {
      font-size: 16px;
      font-weight: 600;
    }

    .status-approved {
      background-color: #e8f5e9;
      border: 1px solid #a5d6a7;
    }

    .status-approved .status-text {
      color: #2e7d32;
    }

    .status-reject {
      background-color: #fce4ec;
      border: 1px solid #ef9a9a;
    }

    .status-reject .status-text {
      color: #c62828;
    }

    .status-default {
      background-color: #f3e5f5;
      border: 1px solid #ce93d8;
    }

    .status-default .status-text {
      color: #6a1b9a;
    }

    .detail-table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
    }

    .detail-table tr {
      border-bottom: 1px solid #f0f0f0;
    }

    .detail-table tr:last-child {
      border-bottom: none;
    }

    .detail-table td {
      padding: 12px 16px;
      font-size: 14px;
      color: #555;
      vertical-align: top;
    }

    .detail-table td:first-child {
      font-weight: 600;
      color: #333;
      width: 35%;
      white-space: nowrap;
    }

    .admin-reason {
      background-color: #fff3e0;
      border-left: 4px solid #ff9800;
      padding: 12px 16px;
      border-radius: 0 8px 8px 0;
      margin: 16px 0;
      font-size: 14px;
      color: #e65100;
    }

    .admin-reason strong {
      color: #bf360c;
    }

    .info-note {
      text-align: center;
      padding: 14px;
      background-color: #f5f5f5;
      border: 1px solid #e0e0e0;
      border-radius: 8px;
      margin: 16px 0;
      font-size: 14px;
      color: #555;
    }

    .footer {
      background-color: #0a051e;
      text-align: center;
      padding: 16px 20px;
      font-size: 12px;
    }

    .footer p {
      margin: 3px 0;
      color: #bbb;
    }
  </style>
</head>

<body>
  <div class="container">
    <div class="card">

      <!-- Dynamic header color based on status -->
      <% if (status.toLowerCase() === 'approve' || status.toLowerCase() === 'approved') { %>
        <div class="header header-approved">
      <% } else if (status.toLowerCase() === 'reject' || status.toLowerCase() === 'rejected') { %>
        <div class="header header-reject">
      <% } else { %>
        <div class="header header-default">
      <% } %>
          <img src="https://trackingapi.crrescita.com/images/company/logo2024-10-11T12-03-49.507Z-abpallogo.jpeg"
            alt="T.E.L" />
          <h2>🗓️ Leave Request Update</h2>
          <span class="badge"><%= leave_type %></span>
        </div>

      <div class="body-content">
        <p class="greeting">Hello <strong><%= employee_name %></strong>,</p>

        <!-- Status Banner -->
        <% if (status.toLowerCase() === 'approve' || status.toLowerCase() === 'approved') { %>
          <div class="status-banner status-approved">
            <span class="status-icon">✅</span>
            <span class="status-text">Leave Approved</span>
          </div>
        <% } else if (status.toLowerCase() === 'reject' || status.toLowerCase() === 'rejected') { %>
          <div class="status-banner status-reject">
            <span class="status-icon">❌</span>
            <span class="status-text">Leave Rejected</span>
          </div>
        <% } else { %>
          <div class="status-banner status-default">
            <span class="status-icon">📋</span>
            <span class="status-text">Status: <%= status %></span>
          </div>
        <% } %>

        <table class="detail-table">
          <tr>
            <td>📋 Leave Type</td>
            <td><%= leave_type %></td>
          </tr>
          <tr>
            <td>📅 From</td>
            <td><%= from_date %></td>
          </tr>
          <tr>
            <td>📅 To</td>
            <td><%= to_date %></td>
          </tr>
          <tr>
            <td>📊 Status</td>
            <td><strong><%= status %></strong></td>
          </tr>
        </table>

        <% if (admin_reason) { %>
          <div class="admin-reason">
            <strong>💬 Admin Reason:</strong><br />
            <%= admin_reason %>
          </div>
        <% } %>

        <div class="info-note">
          📱 Open the <strong>T.E.L App</strong> to view your updated leave details.
        </div>
      </div>

      <div class="footer">
        <p>&copy; 2026 Crrescita. All Rights Reserved.</p>
      </div>
    </div>
  </div>
</body>

</html>